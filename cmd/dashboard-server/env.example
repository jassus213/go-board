# GoBoard Configuration Example
# Copy this file to .env and update with your actual values

# ============================================================================
# Server Configuration
# ============================================================================

# HTTP Server Port (for WebSocket and health checks)
HTTP_PORT=:8080

# gRPC Server Port
GRPC_PORT=:50051

# ============================================================================
# Redis Configuration
# ============================================================================

# Redis server address (host:port)
REDIS_ADDR=localhost:6379

# Redis password (leave empty if no password)
REDIS_PASS=

# Redis key prefix for namespace isolation
REDIS_PREFIX=prod:

# ============================================================================
# Authentication Configuration
# ============================================================================

# Shared secret for StaticVerifier (system-to-service communication)
# IMPORTANT: Change this in production!
AUTH_SECRET=super-secret-key

# JWT Secret for JWTVerifier (user authentication)
# IMPORTANT: Use a strong secret in production (at least 32 characters)
JWT_SECRET=your-jwt-secret-key-change-me-in-production

# Authentication mode: static, jwt, or noop
# - static: Simple shared secret (for internal services)
# - jwt: JSON Web Token validation (recommended for users)
# - noop: No authentication (ONLY for local development)
AUTH_MODE=jwt

# ============================================================================
# CORS Configuration
# ============================================================================

# Allowed origins for WebSocket connections (comma-separated)
# Examples:
# - Single origin: https://example.com
# - Multiple origins: https://example.com,https://app.example.com
# - Localhost for development: http://localhost:3000,http://localhost:5173
# - Wildcard (NOT RECOMMENDED for production): *
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# Allow credentials (cookies, authorization headers)
# Set to true if your frontend needs to send credentials
CORS_ALLOW_CREDENTIALS=true

# ============================================================================
# Logging Configuration
# ============================================================================

# Log level: debug, info, warn, error
LOG_LEVEL=info

# Log format: json or console
LOG_FORMAT=json

# ============================================================================
# Production Settings
# ============================================================================

# Environment: development, staging, production
ENV=development

# Enable debug mode (more verbose logging)
DEBUG=false

# ============================================================================
# Optional: Rate Limiting
# ============================================================================

# Maximum WebSocket messages per second per client
# WS_RATE_LIMIT=10

# Maximum gRPC requests per second per client
# GRPC_RATE_LIMIT=100
